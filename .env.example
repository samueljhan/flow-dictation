# Vertex AI (Gemini). Auth is Application Default Credentials — no API key:
#   local:     gcloud auth application-default login
#   Cloud Run: the service account (roles/aiplatform.user)
GOOGLE_CLOUD_PROJECT=flow-dictation-prod
VERTEX_LOCATION=us-east1

# Model overrides (optional — defaults shown). Each task routes independently:
# set one of these on the Cloud Run service to A/B that task alone, with no code
# change and no effect on the others. Compare the result with
# GET /api/usage/summary, which groups est_cost by model and label.
MODEL_DETECT=gemini-2.5-flash-lite   # study-type classification (cheap, high volume)
MODEL_REPORT=gemini-2.5-flash        # proofread · reword · describe · full report structure
MODEL_REVIEW=gemini-2.5-pro          # draft review edits + read-out note integration
MODEL_IMPRESSION=gemini-2.5-pro      # Generate Impression + the full report's impression
MODEL_RADQA=gemini-2.5-pro           # Quick Rad Question — the chip, i.e. references on (Google Search grounding)
MODEL_SYNTHESIZE=gemini-2.5-pro      # Synthesize Report (prior report + new information)
MODEL_CHAT=gemini-2.5-pro            # plain free text — same prompt as above, references off (defaults to MODEL_RADQA)

# Database — Cloud SQL Postgres.
# Cloud Run: set INSTANCE_CONNECTION_NAME and the app connects over the Unix
# socket /cloudsql/<instance> mounted by --add-cloudsql-instances.
INSTANCE_CONNECTION_NAME=flow-dictation-prod:us-east1:flow-dictation-db
# Local: leave INSTANCE_CONNECTION_NAME unset, run
#   cloud-sql-proxy flow-dictation-prod:us-east1:flow-dictation-db --port 5433
# and point the standard PG* variables at it instead:
# PGHOST=127.0.0.1
# PGPORT=5433
PGUSER=fdapp
PGPASSWORD=                            # Secret Manager on Cloud Run; never commit the real value
PGDATABASE=flowdictation

# Authentication (single user)
ALLOWED_EMAILS=samueljhan@gmail.com   # Google accounts allowed to sign in (comma-separated)
SESSION_SECRET=                        # long random string; REQUIRED or sessions reset on redeploy
APP_USERNAME=                          # username for password sign-in (defaults to first ALLOWED_EMAILS)
APP_PASSWORD=                          # password for password sign-in (never commit the real value)

# Google sign-in OAuth (identity only — the Gmail send routes were removed)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server
PORT=8080
