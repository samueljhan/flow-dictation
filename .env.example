# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model overrides (optional — defaults shown). Each task routes independently:
# set one of these in Railway to A/B that task alone, with no code change and no
# effect on the others. Compare the result with GET /api/usage/summary, which
# groups est_cost by model and label.
MODEL_DETECT=claude-haiku-4-5      # study-type classification (cheap, high volume)
MODEL_REPORT=claude-sonnet-4-6     # proofread · reword · describe · full report structure
MODEL_REVIEW=claude-opus-5         # draft review edits + read-out note integration
MODEL_IMPRESSION=claude-opus-5     # Generate Impression + the full report's impression
MODEL_RADQA=claude-opus-5          # Quick Rad Question — the chip, i.e. references on
MODEL_SYNTHESIZE=claude-opus-5     # Synthesize Report (prior report + new information)
MODEL_CHAT=claude-opus-5           # plain free text — same prompt as above, references off
MODEL_FALLBACK=claude-opus-4-8     # used on any path when safety filters decline

# Authentication (single user)
ALLOWED_EMAILS=samueljhan@gmail.com   # Google accounts allowed to sign in (comma-separated)
SESSION_SECRET=                        # long random string; REQUIRED or sessions reset on redeploy
APP_USERNAME=                          # username for password sign-in (defaults to first ALLOWED_EMAILS)
APP_PASSWORD=                          # password for password sign-in (never commit the real value)

# Supabase (server-side only — service role key is never sent to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Gmail OAuth (backend routes only; no UI currently)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server
PORT=8080
